---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllTags, paramSlug } from '../../lib/posts';

const posts = await getAllPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Tags" description="태그별 글 목록입니다.">
  <h1 class="mb-6 text-2xl font-extrabold text-text">Tags</h1>
  {
    tags.length > 0 ? (
      <div class="flex flex-wrap gap-2">
        {tags.map((t) => (
          <a
            href={`/tags/${paramSlug(t.tag)}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-text-muted transition-colors hover:border-accent/40 hover:text-text"
          >
            <span>#{t.tag}</span>
            <span class="text-xs text-text-faint">{t.count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-text-faint">아직 등록된 태그가 없습니다.</p>
    )
  }
</BaseLayout>
