---
import { Icon } from 'astro-icon/components';
---

<button
  id="back-to-top"
  type="button"
  aria-label="맨 위로 이동"
  class="fixed bottom-6 right-6 z-30 flex h-11 w-11 translate-y-4 items-center justify-center rounded-full border border-border bg-surface text-text opacity-0 shadow-lg transition-all duration-200 pointer-events-none hover:bg-surface-hover data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 data-[visible=true]:pointer-events-auto"
  data-visible="false"
>
  <Icon name="lucide:arrow-up" class="h-5 w-5" />
</button>

<script>
  const btn = document.getElementById('back-to-top');

  function onScroll() {
    if (!btn) return;
    btn.dataset.visible = window.scrollY > 480 ? 'true' : 'false';
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
