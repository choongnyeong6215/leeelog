---
import { Icon } from 'astro-icon/components';
import type { CategoryGroupWithCount } from '../lib/categories';

interface Props {
  groups: CategoryGroupWithCount[];
}
const { groups } = Astro.props;
---

<details class="group rounded-xl border border-border bg-surface" open>
  <summary
    class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-xs font-bold tracking-wide text-text-muted [&::-webkit-details-marker]:hidden"
  >
    <span>CATEGORIES</span>
    <Icon name="lucide:chevron-down" class="h-3.5 w-3.5 transition-transform group-open:rotate-180" />
  </summary>
  <div class="space-y-4 border-t border-border px-4 py-3">
    {
      groups.map((group) => (
        <div>
          <p class="mb-1.5 text-sm font-bold text-text">{group.label}</p>
          <ul class="space-y-0.5">
            {group.children.map((leaf) => (
              <li>
                <a
                  href={`/blog?category=${leaf.slug}`}
                  class="flex items-center justify-between rounded-lg py-1 pl-3 pr-2 text-sm text-text-muted transition-colors hover:bg-surface-hover hover:text-text"
                >
                  <span>{leaf.label}</span>
                  <span class="rounded-full bg-tag-bg px-2 py-0.5 text-[11px] text-tag-fg">{leaf.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    {groups.length === 0 && <p class="text-sm text-text-faint">아직 분류된 글이 없습니다.</p>}
  </div>
</details>
