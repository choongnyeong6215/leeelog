---
interface Props {
  variant?: 'category' | 'tag' | 'tech';
  text: string;
  href?: string;
  version?: string | null;
}

const { variant = 'tag', text, href, version } = Astro.props;

const variantClass = {
  category: 'bg-badge-bg text-badge-fg',
  tag: 'bg-tag-bg text-tag-fg hover:bg-surface-hover',
  tech: 'bg-accent text-accent-fg',
}[variant];

const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold whitespace-nowrap transition-colors',
    variantClass,
  ]}
>
  {variant === 'tag' ? `#${text}` : text}
  {version ? <span class="opacity-80 font-normal">{version}</span> : null}
</Tag>
