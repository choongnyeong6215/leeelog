---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts, getAllTags } from '../../lib/posts';
import { getCategoryTreeWithCounts } from '../../lib/categories';

const posts = await getAllPosts();
const tags = getAllTags(posts);
const categoryGroups = getCategoryTreeWithCounts(posts);
const flatCategories = categoryGroups.flatMap((group) => group.children);
---

<BaseLayout title="Blog" description="전체 글 목록입니다.">
  <h1 class="mb-6 text-2xl font-extrabold text-text">Blog</h1>

  {
    posts.length > 0 && (
      <>
        <div class="mb-3 flex flex-wrap gap-2">
          <button type="button" data-filter-category="all" class="filter-chip is-active">
            전체
          </button>
          {flatCategories.map((c) => (
            <button type="button" data-filter-category={c.slug} class="filter-chip">
              {c.label} ({c.count})
            </button>
          ))}
        </div>
        <div class="mb-8 flex flex-wrap gap-2">
          <button type="button" data-filter-tag="all" class="filter-chip is-active">
            전체 태그
          </button>
          {tags.map((t) => (
            <button type="button" data-filter-tag={t.tag} class="filter-chip">
              #{t.tag} ({t.count})
            </button>
          ))}
        </div>
      </>
    )
  }

  {
    posts.length > 0 ? (
      <>
        <div id="blog-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <div data-post-card data-category={post.data.category} data-tags={post.data.tags.join(',')}>
              <PostCard post={post} />
            </div>
          ))}
        </div>
        <p id="blog-empty" class="hidden py-10 text-center text-sm text-text-faint">
          해당 조건의 글이 없습니다.
        </p>
        <div class="mt-8 flex justify-center">
          <button id="load-more" type="button" class="filter-chip hidden">
            더 보기
          </button>
        </div>
      </>
    ) : (
      <p class="text-sm text-text-faint">아직 작성된 글이 없습니다.</p>
    )
  }
</BaseLayout>

<script>
  const PAGE_SIZE = 9;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-category]'));
  const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]'));
  const loadMoreBtn = document.getElementById('load-more');
  const emptyMsg = document.getElementById('blog-empty');

  const params = new URLSearchParams(location.search);
  let activeCategory = params.get('category') || 'all';
  let activeTag = params.get('tag') || 'all';
  let visibleCount = PAGE_SIZE;

  function matches(card: HTMLElement) {
    const category = card.dataset.category ?? '';
    const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
    const categoryOk = activeCategory === 'all' || category === activeCategory;
    const tagOk = activeTag === 'all' || tags.includes(activeTag);
    return categoryOk && tagOk;
  }

  function render() {
    let shown = 0;
    let matchedTotal = 0;
    for (const card of cards) {
      if (matches(card)) {
        matchedTotal += 1;
        const show = shown < visibleCount;
        card.classList.toggle('hidden', !show);
        if (show) shown += 1;
      } else {
        card.classList.add('hidden');
      }
    }
    emptyMsg?.classList.toggle('hidden', matchedTotal > 0);
    loadMoreBtn?.classList.toggle('hidden', matchedTotal <= visibleCount);
    categoryButtons.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.filterCategory === activeCategory));
    tagButtons.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.filterTag === activeTag));
  }

  categoryButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filterCategory ?? 'all';
      visibleCount = PAGE_SIZE;
      render();
    }),
  );
  tagButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.filterTag ?? 'all';
      visibleCount = PAGE_SIZE;
      render();
    }),
  );
  loadMoreBtn?.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    render();
  });

  render();
</script>
