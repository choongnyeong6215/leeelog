---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getAllPosts } from '../lib/posts';
import { SITE } from '../config';

const posts = await getAllPosts();
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section>
    <h2 class="mb-5 text-xl font-bold text-text">📄 최근 포스트</h2>
    {
      posts.length > 0 ? (
        <>
          <div id="recent-post-list" class="flex flex-col gap-4">
            {posts.map((post) => (
              <div data-post-item>
                <PostListItem post={post} />
              </div>
            ))}
          </div>
          <div id="recent-post-sentinel" class="h-1"></div>
        </>
      ) : (
        <p class="text-sm text-text-faint">아직 작성된 글이 없습니다.</p>
      )
    }
  </section>
</BaseLayout>

<script>
  const PAGE_SIZE = 10;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-post-item]'));
  const sentinel = document.getElementById('recent-post-sentinel');
  let visibleCount = 0;
  let observer: IntersectionObserver | null = null;

  function revealMore() {
    if (visibleCount >= items.length) return;
    const next = Math.min(visibleCount + PAGE_SIZE, items.length);
    for (let i = visibleCount; i < next; i++) {
      items[i].classList.remove('hidden');
    }
    visibleCount = next;
    if (visibleCount >= items.length) {
      observer?.disconnect();
      sentinel?.classList.add('hidden');
    }
  }

  items.forEach((item) => item.classList.add('hidden'));
  revealMore();

  if (sentinel && items.length > PAGE_SIZE) {
    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) revealMore();
      },
      { rootMargin: '400px' },
    );
    observer.observe(sentinel);
  }
</script>
