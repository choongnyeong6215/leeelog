---
import { getPageWindow } from '../lib/pagination';

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

function pageHref(page: number): string {
  return page === 1 ? '/' : `/page/${page}`;
}

const { pages: windowPages, showFirst, showLeftEllipsis, showLast, showRightEllipsis } = getPageWindow(
  currentPage,
  totalPages,
);

const prevHref = currentPage > 1 ? pageHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? pageHref(currentPage + 1) : null;

const navLinkClass =
  'rounded-lg border border-border px-3 py-1.5 text-sm text-text-muted transition-colors hover:bg-surface-hover hover:text-text';
const pageLinkClass = (active: boolean) =>
  [
    'flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-colors',
    active ? 'bg-accent text-accent-fg' : 'text-text-muted hover:bg-surface-hover hover:text-text',
  ].join(' ');
---

{
  totalPages > 1 && (
    // 이전/다음 유무와 무관하게 페이지 번호 묶음이 항상 중앙(가운데 열)에 오도록 3열 그리드로 구성.
    // 가운데 "auto" 열이 번호 묶음의 실제 너비를 갖고, 양옆 "1fr" 열이 남는 공간을 동일하게 나눠 가지므로
    // 한쪽 버튼이 없어도(빈 열이어도) 중앙 정렬이 깨지지 않는다.
    <nav aria-label="페이지 네비게이션" class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
      <div class="flex justify-start">
        {prevHref && (
          <a href={prevHref} class={navLinkClass}>
            이전
          </a>
        )}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-1">
        {showFirst && (
          <a href={pageHref(1)} class={pageLinkClass(false)}>
            1
          </a>
        )}
        {showLeftEllipsis && <span class="flex h-9 w-9 items-center justify-center text-sm text-text-faint">…</span>}
        {windowPages.map((page) => (
          <a
            href={pageHref(page)}
            aria-current={page === currentPage ? 'page' : undefined}
            class={pageLinkClass(page === currentPage)}
          >
            {page}
          </a>
        ))}
        {showRightEllipsis && <span class="flex h-9 w-9 items-center justify-center text-sm text-text-faint">…</span>}
        {showLast && (
          <a href={pageHref(totalPages)} class={pageLinkClass(false)}>
            {totalPages}
          </a>
        )}
      </div>

      <div class="flex justify-end">
        {nextHref && (
          <a href={nextHref} class={navLinkClass}>
            다음
          </a>
        )}
      </div>
    </nav>
  )
}
