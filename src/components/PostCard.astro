---
import { Icon } from 'astro-icon/components';
import Badge from './Badge.astro';
import { getCategoryLeaf } from '../config';
import { getPostUrl, type Post } from '../lib/posts';
import { estimateReadingMinutes } from '../lib/readingTime';
import { formatDateLong } from '../lib/dates';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const categoryLabel = getCategoryLeaf(post.data.category)?.leaf.label ?? post.data.category;
const minutes = estimateReadingMinutes(post.body ?? '');
const url = getPostUrl(post);
---

<a
  href={url}
  class="group flex flex-col rounded-xl border border-border bg-surface p-5 transition-all duration-200 hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-black/5"
>
  <div class="mb-3 flex items-start justify-between gap-2">
    <Badge variant="category" text={categoryLabel} />
    <span class="flex items-center gap-1 text-xs text-text-faint">
      <Icon name="lucide:clock" class="h-3.5 w-3.5" />
      {minutes}분
    </span>
  </div>
  <h3 class="mb-2 line-clamp-2 min-h-[2.75rem] text-lg font-bold leading-snug text-text group-hover:text-accent">
    {post.data.title}
  </h3>
  <p class="mb-4 line-clamp-2 flex-1 text-sm text-text-muted">{post.data.description}</p>
  <div class="mt-auto flex flex-wrap items-center justify-between gap-2 text-xs text-text-faint">
    <span class="flex items-center gap-1">
      <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
      {formatDateLong(post.data.pubDate)}
    </span>
    <div class="flex flex-wrap gap-1">
      {post.data.tags.slice(0, 3).map((tag) => <Badge variant="tag" text={tag} />)}
    </div>
  </div>
</a>
