---
import { Icon } from 'astro-icon/components';
import Badge from './Badge.astro';
import { getPostUrl, type Post } from '../lib/posts';
import { formatDateLong } from '../lib/dates';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const url = getPostUrl(post);
---

<a
  href={url}
  class="group block rounded-xl border border-border bg-surface p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-lg hover:shadow-black/5"
>
  <h3 class="text-lg font-bold leading-snug text-text group-hover:text-accent sm:text-xl">
    {post.data.title}
  </h3>
  {
    post.data.description && (
      <p class="mt-2 line-clamp-2 text-sm text-text-muted">{post.data.description}</p>
    )
  }
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-text-faint">
    <span class="flex items-center gap-1">
      <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
      {formatDateLong(post.data.pubDate)}
    </span>
    {
      post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {post.data.tags.map((tag) => (
            <Badge variant="tag" text={tag} />
          ))}
        </div>
      )
    }
  </div>
</a>
