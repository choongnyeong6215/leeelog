---
import { Icon } from 'astro-icon/components';
import { PROFILE, SOCIAL_LINKS } from '../config';
---

<div class="flex flex-col items-center rounded-xl border border-border bg-surface p-5 text-center">
  <img
    src={PROFILE.avatar}
    alt={PROFILE.nickname}
    width="80"
    height="80"
    class="h-20 w-20 rounded-full border border-border object-cover"
  />
  <p class="mt-3 text-base font-bold text-text">{PROFILE.nickname}</p>
  <ul class="mt-4 w-full space-y-1">
    {
      SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-left text-sm text-text-muted transition-colors hover:bg-surface-hover hover:text-text"
          >
            <Icon name={link.icon} class="h-4 w-4 shrink-0" />
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
