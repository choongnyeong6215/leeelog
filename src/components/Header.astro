---
import { SITE, NAV_LINKS } from '../config';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="shrink-0 text-lg font-extrabold text-text">
      {SITE.title}
    </a>
    <nav class="hidden flex-1 items-center gap-1 overflow-x-auto md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'shrink-0 rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-accent-soft text-accent'
                : 'text-text-muted hover:bg-surface-hover hover:text-text',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <SearchTrigger />
      <ThemeToggle />
    </div>
  </div>
  <nav class="flex items-center gap-1 overflow-x-auto border-t border-border px-4 py-2 md:hidden">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'shrink-0 rounded-full px-3 py-1 text-xs font-medium',
            isActive(link.href) ? 'bg-accent-soft text-accent' : 'text-text-muted',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
