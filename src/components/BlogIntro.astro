---
import { Icon } from 'astro-icon/components';
import { SITE, SOCIAL_LINKS } from '../config';
---

<section class="mb-8 border-b border-border pb-8">
  <h1 class="text-2xl font-extrabold text-text sm:text-3xl">{SITE.title}</h1>
  <p class="mt-2 text-sm text-text-muted sm:text-base">{SITE.description}</p>
  <ul class="mt-4 flex flex-wrap gap-4">
    {
      SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors hover:text-text"
          >
            <Icon name={link.icon} class="h-4 w-4" />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
