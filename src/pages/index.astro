---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getAllPosts } from '../lib/posts';
import { SITE } from '../config';

const posts = await getAllPosts();
---

<BaseLayout title={SITE.title} description={SITE.description}>
  {
    posts.length > 0 ? (
      <>
        <div id="recent-post-list" class="flex flex-col gap-4">
          {posts.map((post) => (
            <div data-post-item>
              <PostListItem post={post} />
            </div>
          ))}
        </div>
        <div class="mt-8 flex justify-center">
          <button
            id="load-more"
            type="button"
            class="hidden items-center gap-1.5 text-sm text-text-muted transition-colors hover:text-text"
          >
            더 보기
            <Icon name="lucide:arrow-down" class="h-4 w-4" />
          </button>
        </div>
      </>
    ) : (
      <p class="text-sm text-text-faint">아직 작성된 글이 없습니다.</p>
    )
  }
</BaseLayout>

<script>
  const PAGE_SIZE = 10;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-post-item]'));
  const loadMoreBtn = document.getElementById('load-more');
  let visibleCount = 0;

  function revealMore() {
    const next = Math.min(visibleCount + PAGE_SIZE, items.length);
    for (let i = visibleCount; i < next; i++) {
      items[i].classList.remove('hidden');
    }
    visibleCount = next;
    const hasMore = visibleCount < items.length;
    // hidden과 inline-flex를 동시에 두면 Tailwind 유틸리티 순서에 따라 display가 깨질 수 있어 항상 함께 토글한다.
    loadMoreBtn?.classList.toggle('hidden', !hasMore);
    loadMoreBtn?.classList.toggle('inline-flex', hasMore);
  }

  items.forEach((item) => item.classList.add('hidden'));
  revealMore();
  loadMoreBtn?.addEventListener('click', revealMore);
</script>
