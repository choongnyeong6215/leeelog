---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <div class="group relative lg:sticky lg:top-20 lg:self-start">
      <div
        aria-hidden="true"
        class="hidden lg:flex lg:flex-col lg:gap-1.5 lg:py-1 lg:transition-opacity lg:group-hover:opacity-0 lg:group-focus-within:opacity-0"
      >
        {items.map((h) => (
          <span
            data-toc-tick
            data-target={h.slug}
            class:list={['h-0.5 rounded-full bg-text-faint transition-colors', h.depth === 3 ? 'ml-2 w-3' : 'w-5']}
          />
        ))}
      </div>
      <nav
        aria-label="목차"
        class="lg:invisible lg:absolute lg:right-0 lg:top-0 lg:z-10 lg:w-64 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto lg:rounded-xl lg:border lg:border-border lg:bg-surface lg:p-4 lg:opacity-0 lg:shadow-xl lg:transition-opacity lg:group-hover:visible lg:group-hover:opacity-100 lg:group-focus-within:visible lg:group-focus-within:opacity-100"
      >
        <p class="mb-3 text-xs font-bold tracking-wide text-text-muted">목차</p>
        <ul class="space-y-0.5 border-l border-border text-sm">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link
                data-target={h.slug}
                class:list={[
                  '-ml-px block border-l-2 border-transparent py-1 pl-3 text-text-muted transition-colors hover:text-text',
                  h.depth === 3 && 'pl-6 text-[13px]',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const ticks = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-tick]'));

  function setActive(id: string | null) {
    for (const link of links) {
      const active = link.dataset.target === id;
      link.classList.toggle('border-accent', active);
      link.classList.toggle('font-bold', active);
      link.classList.toggle('text-text', active);
      link.classList.toggle('text-text-muted', !active);
    }
    for (const tick of ticks) {
      const active = tick.dataset.target === id;
      tick.classList.toggle('bg-accent', active);
      tick.classList.toggle('bg-text-faint', !active);
    }
  }

  if (links.length > 0) {
    const targets = links
      .map((link) => (link.dataset.target ? document.getElementById(link.dataset.target) : null))
      .filter((el): el is HTMLElement => Boolean(el));

    // 섹션 사이 간격이 넓으면 IntersectionObserver의 관찰 밴드에 아무 헤딩도 걸리지 않는
    // 구간이 생겨 하이라이트가 사라진다. 대신 "가장 최근에 지나온 헤딩"을 스크롤 위치로 직접 계산한다.
    const OFFSET = 120;
    let ticking = false;

    function update() {
      ticking = false;
      let currentId: string | null = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top - OFFSET <= 0) {
          currentId = el.id;
        } else {
          break;
        }
      }
      setActive(currentId ?? targets[0]?.id ?? null);
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
