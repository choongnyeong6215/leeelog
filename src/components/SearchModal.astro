---
import { Icon } from 'astro-icon/components';
---

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/40 p-4 pt-[12vh] backdrop-blur-sm"
>
  <div data-search-box class="w-full max-w-lg overflow-hidden rounded-xl border border-border bg-surface shadow-2xl">
    <div class="flex items-center gap-2 border-b border-border px-4 py-3">
      <Icon name="lucide:search" class="h-4 w-4 shrink-0 text-text-faint" />
      <input
        id="search-input"
        type="text"
        placeholder="글 제목, 태그로 검색..."
        autocomplete="off"
        class="w-full bg-transparent text-sm text-text placeholder:text-text-faint focus:outline-none"
      />
      <kbd class="shrink-0 rounded border border-border px-1.5 py-0.5 text-[10px] text-text-faint">ESC</kbd>
    </div>
    <div id="search-tags" class="flex flex-wrap gap-1.5 border-b border-border px-4 py-3"></div>
    <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2"></ul>
    <p id="search-empty" class="hidden px-4 py-8 text-center text-sm text-text-faint">검색 결과가 없습니다.</p>
  </div>
</div>

<script>
  import { animate } from 'motion';

  type SearchDoc = { title: string; description: string; url: string; category: string; tags: string[] };

  let index: SearchDoc[] | null = null;
  let activeTag: string | null = null;

  const overlay = document.getElementById('search-overlay');
  const box = document.querySelector<HTMLElement>('[data-search-box]');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const tagsBar = document.getElementById('search-tags');
  const results = document.getElementById('search-results');
  const empty = document.getElementById('search-empty');
  const trigger = document.getElementById('search-trigger');

  async function ensureIndex() {
    if (index) return;
    const res = await fetch(`${import.meta.env.BASE_URL}search-index.json`);
    index = await res.json();
    renderTags();
  }

  function isOpen() {
    return overlay?.classList.contains('flex') ?? false;
  }

  function openModal() {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    // 모달이 열려있는 동안 배경 스크롤을 막는다. backdrop-blur가 걸린 오버레이 뒤로
    // 배경이 계속 스크롤되면 매 프레임 블러를 다시 그려야 해서 버벅거림이 생긴다.
    document.documentElement.classList.add('overflow-hidden');
    if (overlay) animate(overlay, { opacity: [0, 1] }, { duration: 0.18 });
    if (box) animate(box, { opacity: [0, 1], scale: [0.97, 1], y: [-8, 0] }, { duration: 0.2, ease: 'easeOut' });
    // 인덱스 로딩이 끝나기 전에 사용자가 타이핑을 마칠 수 있으므로, 로딩 완료 후 현재 입력값으로 다시 렌더링한다.
    void ensureIndex().then(() => renderResults(search(input?.value ?? '')));
    input?.focus();
  }

  function closeModal() {
    if (!isOpen()) return;
    document.documentElement.classList.remove('overflow-hidden');
    const finish = () => {
      overlay?.classList.add('hidden');
      overlay?.classList.remove('flex');
      if (input) input.value = '';
      activeTag = null;
      renderTags();
      renderResults([]);
    };
    if (overlay && box) {
      const animationsDone = Promise.all([
        animate(overlay, { opacity: [1, 0] }, { duration: 0.15 }).finished,
        animate(box, { opacity: [1, 0], scale: [1, 0.97], y: [0, -8] }, { duration: 0.15 }).finished,
      ]);
      // 탭이 백그라운드로 밀리는 등의 이유로 애니메이션이 끝나지 않는 경우에도
      // 모달이 영구히 안 닫힌 상태로 남지 않도록 타임아웃으로 정리를 보장한다.
      const timeout = new Promise((resolve) => setTimeout(resolve, 300));
      Promise.race([animationsDone, timeout]).then(finish);
    } else {
      finish();
    }
  }

  function renderTags() {
    if (!tagsBar || !index) return;
    const tags = Array.from(new Set(index.flatMap((doc) => doc.tags))).sort((a, b) => a.localeCompare(b));
    tagsBar.innerHTML = '';
    for (const tag of tags) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.textContent = `#${tag}`;
      chip.dataset.tag = tag;
      const active = tag === activeTag;
      chip.className = active
        ? 'rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-fg'
        : 'rounded-full bg-tag-bg px-2.5 py-1 text-xs font-semibold text-tag-fg transition-colors hover:bg-surface-hover';
      chip.addEventListener('click', () => {
        activeTag = activeTag === tag ? null : tag;
        renderTags();
        renderResults(search(input?.value ?? ''));
      });
      tagsBar.appendChild(chip);
    }
  }

  function renderResults(items: SearchDoc[]) {
    if (!results || !empty || !input) return;
    results.innerHTML = '';
    const hasFilter = input.value.trim().length > 0 || activeTag !== null;
    empty.classList.toggle('hidden', !hasFilter || items.length > 0);

    for (const item of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = item.url;
      a.className = 'block rounded-lg px-3 py-2 hover:bg-surface-hover';
      const titleEl = document.createElement('p');
      titleEl.className = 'text-sm font-medium text-text';
      titleEl.textContent = item.title;
      const metaEl = document.createElement('p');
      metaEl.className = 'text-xs text-text-faint';
      metaEl.textContent = item.category;
      a.append(titleEl, metaEl);
      li.appendChild(a);
      results.appendChild(li);
    }
  }

  function search(query: string): SearchDoc[] {
    if (!index) return [];
    const q = query.trim().toLowerCase();
    if (!q && !activeTag) return [];
    return index
      .filter((doc) => {
        const matchesTag = !activeTag || doc.tags.includes(activeTag);
        const matchesQuery =
          !q ||
          doc.title.toLowerCase().includes(q) ||
          doc.description.toLowerCase().includes(q) ||
          doc.tags.some((tag) => tag.toLowerCase().includes(q));
        return matchesTag && matchesQuery;
      })
      .slice(0, 20);
  }

  trigger?.addEventListener('click', openModal);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeModal();
  });
  input?.addEventListener('input', () => renderResults(search(input.value)));

  window.addEventListener('keydown', (event) => {
    const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
    if (isShortcut) {
      event.preventDefault();
      isOpen() ? closeModal() : openModal();
    } else if (event.key === 'Escape' && isOpen()) {
      closeModal();
    }
  });
</script>
