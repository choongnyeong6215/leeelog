---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { getAllPosts } from '../lib/posts';
import { getTotalPages, POSTS_PAGE_SIZE } from '../lib/pagination';
import { SITE } from '../config';

const posts = await getAllPosts();
const totalPages = getTotalPages(posts.length);
const pagePosts = posts.slice(0, POSTS_PAGE_SIZE);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section>
    <h2 class="mb-5 text-xl font-bold text-text">최근 포스트</h2>
    {
      posts.length > 0 ? (
        <>
          <PostList posts={pagePosts} />
          <Pagination currentPage={1} totalPages={totalPages} />
        </>
      ) : (
        <p class="text-sm text-text-faint">아직 작성된 글이 없습니다.</p>
      )
    }
  </section>
</BaseLayout>
