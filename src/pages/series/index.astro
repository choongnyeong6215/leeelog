---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getSeriesList, seriesSlug } from '../../lib/posts';

const posts = await getAllPosts();
const seriesList = getSeriesList(posts);
---

<BaseLayout title="Series" description="연재 시리즈 목록입니다.">
  <h1 class="mb-6 text-2xl font-extrabold text-text">Series</h1>
  {
    seriesList.length > 0 ? (
      <div class="space-y-4">
        {seriesList.map((series) => (
          <a
            href={`/series/${seriesSlug(series.name)}`}
            class="block rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent/40"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-lg font-bold text-text">{series.name}</h2>
              <span class="shrink-0 text-sm text-text-muted">총 {series.posts.length}편의 글</span>
            </div>
            <ul class="mt-3 space-y-1 text-sm text-text-muted">
              {series.posts.map((post, i) => (
                <li>
                  {i + 1}. {post.data.title}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-text-faint">아직 등록된 시리즈가 없습니다.</p>
    )
  }
</BaseLayout>
