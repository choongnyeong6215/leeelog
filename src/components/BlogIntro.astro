---
import { Icon } from 'astro-icon/components';
import { SITE, SOCIAL_LINKS } from '../config';

interface Props {
  postCount: number;
}

const { postCount } = Astro.props;
---

<section class="mx-auto mb-8 max-w-xl rounded-2xl border border-border bg-surface p-8 text-center">
  <Icon name="lucide:diamond" class="mx-auto h-8 w-8 text-text" />
  <h1 class="mt-3 text-xl font-extrabold text-text">{SITE.title}</h1>
  <p class="mt-1 text-sm text-text-faint">{postCount}개의 글</p>
  <ul class="mt-5 flex items-center justify-center gap-4">
    {
      SOCIAL_LINKS.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="text-text-muted transition-colors hover:text-text"
          >
            <Icon name={link.icon} class="h-5 w-5" />
          </a>
        </li>
      ))
    }
  </ul>
</section>
